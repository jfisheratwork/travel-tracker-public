#!/usr/bin/env bash
set -e

# Skip in CI / GitHub Actions
if [ "$GITHUB_ACTIONS" = "true" ] || [ "$CI" = "true" ]; then
  exit 0
fi

# Deterministic Pre-Push Hook for Travel Tracker
# Enforces full Vitest unit test suite before git push completes.

echo "🚀 Running pre-push verification gate (Vitest unit test suite)..."
CI=true HOME=$(pwd)/scratch NG_CLI_ANALYTICS=false npm test -- --watch=false
echo "✅ All pre-push verification gates passed!"
exit 0
